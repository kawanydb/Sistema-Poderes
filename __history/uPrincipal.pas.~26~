unit uPrincipal;

interface

uses
  Winapi.Windows, Winapi.Messages, System.SysUtils, System.Variants, System.Classes, Vcl.Graphics,
  Vcl.Controls, Vcl.Forms, Vcl.Dialogs, Vcl.StdCtrls, Vcl.ExtCtrls, Vcl.Menus,uEnum,cFuncao,uCadPoderes,
  cCadPoderes,uCadCategoria,cCadCategoria,uDTMConexao, Vcl.Buttons,uCadNivelPoder, FireDAC.Comp.Client;

type
  TdtmPrincipal = class(TForm)
    pnl1: TPanel;
    pnl2: TPanel;
    lbl1: TLabel;
    pnl3: TPanel;
    lbl8: TLabel;
    lbl3: TLabel;
    lbl4: TLabel;
    lbl6: TLabel;
    btnCadCategorias: TSpeedButton;
    btnCadPoderes: TSpeedButton;
    btnNivelPoder: TSpeedButton;
    lbl7: TLabel;
    btnImportarCSV: TSpeedButton;
    btnExportarCSV1: TSpeedButton;
    dlgOpen1: TOpenDialog;
    procedure btnCadPoderesClick(Sender: TObject);
    procedure btnCadCategoriasClick(Sender: TObject);
    procedure btnNivelPoderClick(Sender: TObject);
    procedure btnImportarCSVClick(Sender: TObject);
  private
    procedure ImportarCSV(Caminho: string);
    { Private declarations }
  public
    { Public declarations }
  end;

var
  dtmPrincipal: TdtmPrincipal;

implementation

{$R *.dfm}

procedure TdtmPrincipal.btnCadCategoriasClick(Sender: TObject);
begin
  TFuncao.CriarForm(TfrmCadCategoria, dtmConexao.conexaoDB);
end;

procedure TdtmPrincipal.btnCadPoderesClick(Sender: TObject);
begin
  TFuncao.CriarForm(TfrmCadastroPoderes, dtmConexao.conexaoDB);
end;

procedure TdtmPrincipal.btnNivelPoderClick(Sender: TObject);
begin
  TFuncao.CriarForm(TfrmCadNivelPoder, dtmConexao.conexaoDB);
end;

procedure TdtmPrincipal.btnImportarCSVClick(Sender: TObject);
begin
  if dlgOpen1.Execute then
    ImportarCSV(dlgOpen1.FileName);
end;

procedure TdtmPrincipal.ImportarCSV(Caminho: string);
var
  Lista: TStringList;
  Linha: string;
  Campos: TArray<string>;
  i: Integer;
  Qry: TFDQuery;
begin
  Lista := TStringList.Create;
  Qry := TFDQuery.Create(nil);
  try
    Lista.LoadFromFile(Caminho);
    Qry.Connection := dtmConexao.conexaoDB;

    for i := 1 to Lista.Count - 1 do
    begin
      Linha := Lista[i];

      if Trim(Linha) = '' then
        Continue;

      Campos := Linha.Split([';']);

      if Length(Campos) < 4 then
      begin
        ShowMessage('Erro na linha ' + IntToStr(i));
        Continue;
      end;

      Qry.SQL.Text :=
        'INSERT INTO poderes (nome, descricao, categoria_id, nivel_poder_id) ' +
        'VALUES (:nome, :desc, ' +
        '(SELECT id FROM categorias WHERE nome = :cat), ' +
        '(SELECT id FROM nivel_poder WHERE nivel = :nivel))';

      Qry.ParamByName('nome').AsString := Campos[0];
      Qry.ParamByName('desc').AsString := Campos[1];
      Qry.ParamByName('cat').AsString := Campos[2];
      Qry.ParamByName('nivel').AsString := Campos[3];

      try
        Qry.ExecSQL;
      except
        on E: Exception do
          ShowMessage('Erro linha ' + IntToStr(i) + ': ' + E.Message);
      end;
    end;

    ShowMessage('Importação finalizada!');
  finally
    Lista.Free;
    Qry.Free;
  end;
end;

end.
