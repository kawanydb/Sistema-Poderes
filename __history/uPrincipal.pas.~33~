begin
  TFuncao.CriarForm(TfrmCadNivelPoder, dtmConexao.conexaoDB);
end;

procedure TdtmPrincipal.btnImportarCSVClick(Sender: TObject);
begin
  if dlgOpen1.Execute then
    ImportarCSV(dlgOpen1.FileName);
end;

{$REGION 'IMPORTAR E EXPORTAR'}
procedure TdtmPrincipal.ImportarCSV(Caminho: string);
var
  Lista: TStringList;
  Linha: string;
  Campos: TArray<string>;
  i: Integer;
  QryInsert, QryCheck: TFDQuery;
begin
  Lista := TStringList.Create;
  QryInsert := TFDQuery.Create(nil);
  QryCheck := TFDQuery.Create(nil);
  try
    Lista.LoadFromFile(Caminho, TEncoding.UTF8);

    QryInsert.Connection := dtmConexao.conexaoDB;
    QryCheck.Connection := dtmConexao.conexaoDB;

    for i := 1 to Lista.Count - 1 do
    begin
      Linha := Lista[i];

      if Trim(Linha) = '' then
        Continue;

      Campos := Linha.Split([';']);

      if Length(Campos) < 4 then
      begin
        ShowMessage('Erro na linha ' + IntToStr(i));
        Continue;
      end;

      // ?? VERIFICA DUPLICADO
      QryCheck.Close;
      QryCheck.SQL.Clear;
      QryCheck.SQL.Add('SELECT COUNT(*) AS total FROM poderes WHERE LOWER(nome) = LOWER(:nome)');
      QryCheck.ParamByName('nome').AsString := Campos[0];
      QryCheck.Open;

      if QryCheck.FieldByName('total').AsInteger > 0 then
      begin
        ShowMessage('Já existe: ' + Campos[0]);
        Continue;
      end;

      QryCheck.Close;

      // ?? INSERT
      QryInsert.Close;
      QryInsert.SQL.Clear;
      QryInsert.SQL.Add(
        'INSERT INTO poderes (nome, descricao, categoria_id, nivel_poder_id) ' +
        'VALUES (:nome, :desc, ' +
        '(SELECT id FROM categorias WHERE LOWER(nome) = LOWER(:cat)), ' +
        '(SELECT id FROM nivel_poder WHERE LOWER(nivel) = LOWER(:nivel)) )'
      );

      QryInsert.ParamByName('nome').AsString := Campos[0];
      QryInsert.ParamByName('desc').AsString := Campos[1];
      QryInsert.ParamByName('cat').AsString := Campos[2];
      QryInsert.ParamByName('nivel').AsString := Campos[3];

      try
        QryInsert.ExecSQL;
      except
        on E: Exception do
          ShowMessage('Erro linha ' + IntToStr(i) + ': ' + E.Message);
      end;
    end;

    ShowMessage('Importação finalizada!');
  finally
    QryInsert.Free;
    QryCheck.Free;
    Lista.Free;
  end;
end;

procedure TdtmPrincipal.ExportarCSV(Caminho: string);
var
  Lista: TStringList;
  Qry: TFDQuery;
begin
  Lista := TStringList.Create;
  Qry := TFDQuery.Create(nil);
  try
    Qry.Connection := dtmConexao.conexaoDB;

    Qry.SQL.Text :=
      'SELECT p.nome, p.descricao, c.nome AS categoria, n.nivel ' +
      'FROM poderes p ' +
      'JOIN categorias c ON c.id = p.categoria_id ' +
      'JOIN nivel_poder n ON n.id = p.nivel_poder_id';

    Qry.Open;

    Lista.Add('nome;descricao;categoria;nivel');

    while not Qry.Eof do
    begin
      Lista.Add(
        Qry.FieldByName('nome').AsString + ';' +
        Qry.FieldByName('descricao').AsString + ';' +
        Qry.FieldByName('categoria').AsString + ';' +
        Qry.FieldByName('nivel').AsString
      );

      Qry.Next;
    end;

    Lista.SaveToFile(Caminho, TEncoding.UTF8);

    ShowMessage('Exportado com sucesso!');
  finally
    Qry.Free;
    Lista.Free;
  end;
end;

{$ENDREGION}
end.
