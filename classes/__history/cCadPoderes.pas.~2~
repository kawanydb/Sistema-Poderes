unit cCadPoderes;

interface

uses System.Classes,
     Vcl.Controls,
     Vcl.ExtCtrls,
     Vcl.Dialogs,
     FireDAC.Comp.Client,
     FireDAC.Stan.Error,
     FireDAC.DatS,
     FireDAC.Phys.Intf,
     FireDAC.DApt.Intf,
     FireDAC.Stan.Async,
     FireDAC.DApt,
     FireDAC.Comp.DataSet,
     System.SysUtils,
     FireDAC.Stan.Param,
     System.StrUtils,
     Vcl.Imaging.jpeg,
     Vcl.Graphics,
     System.Variants,
     Data.DB;

type
TPoder = class
  private
      conexaoDB:TFDConnection;
      F_poderId:Integer;
      F_nomePoder:string;
      F_descricao:string;
      F_categoriaId: Integer;
      F_NivelPoderId: Integer;

    public
      constructor Create(aConexao:TFDConnection);
      destructor Destroy; override;
      function Inserir:Boolean;
      function Atualizar:Boolean;
      function Apagar:Boolean;
      function Selecionar(id:Integer):Boolean;
    published
      property codigo        :Integer    read F_poderId        write F_poderId;
      property nome          :string     read F_nomePoder      write F_nomePoder;
      property descricao     :string     read F_descricao      write F_descricao;
      property categoriaId   :Integer    read F_categoriaId    write F_categoriaId;
      property nivelPoderId  :Integer    read F_NivelPoderId   write F_NivelPoderId;

end;

implementation


{$REGION 'Constructor and Destructor'}
constructor TPoder.Create(aConexao: TFDConnection);
begin
  Self.conexaoDB := aConexao;  // salva a conexão
end;

destructor TPoder.Destroy;
begin
  inherited
end;
{$ENDREGION}


end.
